# MEMESNIPR mode: TEST or LIVE
MODE=TEST

# Chain / RPC
CHAIN=solana
SOL_RPC_URL=https://api.mainnet-beta.solana.com

# Emergency control
KILL_SWITCH=false

# Safety behavior
REJECT_ON_UNKNOWN_SIGNALS=false

# Confidence/risk gates — v3: quality over quantity
MIN_SCORE_TO_TRADE=72
MAX_RISK_SCORE_TO_TRADE=30
HIGH_CONFIDENCE_SCORE=80

# Token age limit (minutes)
MAX_TOKEN_AGE_MINUTES=45

# Minimum liquidity floor (USD)
MIN_LIQUIDITY_USD=3000

# Tax limits
MAX_BUY_TAX_PCT=12
MAX_SELL_TAX_PCT=12

# Risk parameters — aggressive for $200 starting capital
# ~3% per trade = ~$6 per position, allows ~6 concurrent positions
TEST_RISK_PER_TRADE_PCT=3.0
TEST_MAX_OPEN_EXPOSURE_PCT=20.0
LIVE_RISK_PER_TRADE_PCT=3.0
LIVE_MAX_OPEN_EXPOSURE_PCT=20.0

# Asymmetric risk control — move stop to breakeven after first take-profit
BREAKEVEN_AFTER_TP1=true

# Trade limits
MAX_TRADES_PER_DAY=40
LOSS_STREAK_HALVE_RISK=3
DAILY_MAX_LOSSES_HALT=8

# v3 Profit ladder & stops — controlled losses, let winners run
STOP_LOSS_PCT=6
TP1_PCT=20
TP1_SELL_PCT=40
TP2_PCT=40
TP2_SELL_PCT=30
TP3_PCT=80
TP3_SELL_PCT=30
TRAILING_STOP_PCT=8
TRAILING_STOP_AFTER_TP1_PCT=8
TRAILING_STOP_AFTER_TP2_PCT=12

# v3 Breakeven & tiered trailing
BREAKEVEN_TRIGGER_PCT=8
TRAILING_ACTIVATE_15_PCT=15
TRAILING_STOP_AT_15_PCT=8
TRAILING_ACTIVATE_30_PCT=30
TRAILING_STOP_AT_30_PCT=12
TRAILING_ACTIVATE_60_PCT=60
TRAILING_STOP_AT_60_PCT=18

# Engine speed (seconds between scans)
SCAN_INTERVAL_SECONDS=5

# Suspicious launch hard-block heuristic
SUSPICIOUS_LAUNCH_WINDOW_SECONDS=120
SUSPICIOUS_MAX_TOP_HOLDER_PCT=35
SUSPICIOUS_MAX_HOLDER_COUNT=50

# Social Signal Engine (centralized signal feed for social sentiment)
SOCIAL_SIGNAL_ENGINE_URL=https://app-sgvdyzun.fly.dev
SOCIAL_SIGNAL_WEIGHT=8.0

# v3 Entry quality filter
ENTRY_MIN_CONDITIONS=2
ENTRY_SOCIAL_SCORE_MIN=5.0
ENTRY_VOLUME_SPIKE_MIN=2.0
ENTRY_LIQUIDITY_MIN_USD=25000

# v3 Social signal influence
SOCIAL_CONFIDENCE_BOOST_6=10.0
SOCIAL_CONFIDENCE_BOOST_7=18.0
SOCIAL_BLOCK_BELOW=3.0

# v3 Trap detection
TRAP_SCORE_THRESHOLD=60.0

# v3 Momentum confirmation
MOMENTUM_PRICE_CHANGE_1M_PCT=3.0
MOMENTUM_VOLUME_SPIKE_MULTIPLIER=1.8

# v3 Trade frequency control
LOSS_STREAK_PAUSE_3_SECONDS=600
LOSS_STREAK_PAUSE_5_SECONDS=1800

# v3 Adaptive position sizing
POSITION_SIZE_BASE_SOL=0.03
POSITION_SIZE_STRONG_MULTIPLIER=1.4
POSITION_SIZE_MODERATE_MULTIPLIER=0.8
POSITION_SIZE_WEAK_MULTIPLIER=0.35

# v3 Trade memory
TRADE_MEMORY_PATH=data/trade_memory.json

# Storage paths
ENGINE_STATE_PATH=data/engine_state.json
TRADES_LOG_PATH=data/trades_log.jsonl
AUDIT_LOG_PATH=data/audit_log.jsonl

# Paper broker simulation
PAPER_BROKER_SEED=1337
PAPER_BASE_PRICE=1.0
PAPER_FEE_BPS=30
PAPER_MAX_SLIPPAGE_BPS=80
PAPER_FILL_PROBABILITY=1.0

# LIVE-only required when MODE=LIVE
LIVE_WALLET_PRIVATE_KEY=
LIVE_WALLET_PUBLIC_KEY=

# Optional TEST wallet vars (not required for simulation)
TEST_WALLET_PRIVATE_KEY=
TEST_WALLET_PUBLIC_KEY=
