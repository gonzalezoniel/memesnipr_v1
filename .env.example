# MEMESNIPR configuration

# MODE can be TEST or LIVE
MODE=TEST

# Solana RPC URL
SOL_RPC_URL=https://api.mainnet-beta.solana.com

# TEST wallet (use a throwaway keypair)
TEST_WALLET_PRIVATE_KEY=
TEST_WALLET_PUBLIC_KEY=

# LIVE wallet (your Phantom) - NEVER commit real values to Git
LIVE_WALLET_PRIVATE_KEY=
LIVE_WALLET_PUBLIC_KEY=
